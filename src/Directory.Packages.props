<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13"/>
        <PackageVersion Include="MQTTnet" Version="5.2.0.1603"/>
        <PackageVersion Include="MQTTnet.Server" Version="5.2.0.1603"/>
    </ItemGroup>

    <ItemGroup Label="Aspire (local orchestration and service defaults)">
        <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Mosquitto" Version="13.6.0"/>
        <!-- Transitive via Aspire.Hosting; pinned above 2.5.302 for GHSA-qhrr-8q5h-9q3h. -->
        <PackageVersion Include="MessagePack" Version="2.5.307"/>
        <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0"/>
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0"/>
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0"/>
    </ItemGroup>

    <ItemGroup Label="Testing">
        <PackageVersion Include="coverlet.msbuild" Version="10.1.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageVersion Include="Testcontainers" Version="4.16.0"/>
        <PackageVersion Include="WireMock.Net" Version="2.19.0"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1"/>
        <PackageVersion Include="xunit.v3" Version="4.0.2"/>
    </ItemGroup>

</Project>
